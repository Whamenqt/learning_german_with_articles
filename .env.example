# --- Frontend (Vite) ---
# Safe to expose in the browser bundle: Supabase's anon key is meant to be public
# and is restricted by Row Level Security policies (see supabase/migrations).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Used for building absolute links (public article URLs, "Copy public URL", exports).
VITE_PUBLIC_SITE_URL=https://german.example.com

# --- Netlify Functions (server-side only, never exposed to the browser) ---
# Used by extract-article.ts. Optional: a UA string that behaves better against
# some sites than the default fetch UA.
EXTRACTOR_USER_AGENT=Mozilla/5.0 (compatible; GermanNewsLearningBot/1.0; +https://german.example.com)

# Netlify Functions do not need the Supabase service role key for this MVP:
# extraction and export functions are stateless (they take input in the request
# body and return a result). If you later add server-side publish/slug checks
# that must bypass RLS, add SUPABASE_SERVICE_ROLE_KEY here and keep it out of
# any VITE_ prefixed variable.
# SUPABASE_SERVICE_ROLE_KEY=
